---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map(page => ({ params: { page: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}><section class="interior-hero"><p class="eyebrow">Free Youth</p><h1>{page.data.title}</h1><p>{page.data.description}</p></section><article class="rich-content"><Content /></article></Base>
