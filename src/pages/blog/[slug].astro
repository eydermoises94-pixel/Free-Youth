---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(post => post.data.published);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cover = post.data.cover?.startsWith('/') ? `${base}${post.data.cover}` : post.data.cover;
---
<Base title={post.data.title} description={post.data.description}><article><header class="interior-hero"><p class="eyebrow">Blog · {post.data.date.toLocaleDateString('es-ES')}</p><h1>{post.data.title}</h1><p>{post.data.description}</p></header>{cover && <img class="article-cover" src={cover} alt="" />}<div class="rich-content"><Content /></div></article></Base>
