---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const events = (await getCollection('agenda')).filter(event => event.data.published);
  return events.map(event => ({ params: { slug: event.id }, props: { event } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cover = event.data.cover?.startsWith('/') ? `${base}${event.data.cover}` : event.data.cover;
---
<Base title={event.data.title} description={event.data.description}><article><header class="interior-hero"><p class="eyebrow">Agenda · {event.data.date.toLocaleDateString('es-ES')}</p><h1>{event.data.title}</h1><p>{event.data.description}</p><p>{event.data.place}</p></header>{cover && <img class="article-cover" src={cover} alt="" />}<div class="rich-content"><Content /></div></article></Base>
