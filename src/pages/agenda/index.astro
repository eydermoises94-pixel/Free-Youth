---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const image = (src: string) => src.startsWith('/') ? `${base}${src}` : src;
const events = (await getCollection('agenda')).filter(event => event.data.published).sort((a,b) => +a.data.date - +b.data.date);
---
<Base title="Agenda"><section class="interior-hero"><p class="eyebrow">Agenda</p><h1>Nos vemos pronto.</h1><p>Reunión habitual: sábados a las 19:00 en Calle Mayor 29, El Prat de Llobregat.</p></section><section class="listing">{events.length ? events.map(event => <a class="list-item" href={`${base}/agenda/${event.id}/`}>{event.data.cover && <img src={image(event.data.cover)} alt="" loading="lazy" />}<small>{event.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })} · {event.data.place}</small><h2>{event.data.title}</h2><p>{event.data.description}</p><span>Ver detalles ↗</span></a>) : <div class="empty-state"><h2>No hay actividades adicionales publicadas.</h2><p>Nos reunimos habitualmente los sábados a las 19:00.</p><a class="text-link" href={`${base}/primera-vez/`}>Cómo venir ↗</a></div>}</section></Base>
